{
  "name": "magpie",
  "productName": "Magpie",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first screenshot and annotation tool",
  "author": "Ryan",
  "homepage": "https://github.com/CheckSomeBytes/magpie",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "desktopName": "works.telesto.Magpie.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "install-desktop-entry": "node scripts/install-dev-desktop.mjs",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@magpie/format": "*",
    "@magpie/stitcher": "*",
    "@tesseract.js-data/eng": "^1.0.0",
    "dbus-next": "^0.10.2",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^3.3.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "konva": "^10.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
